# constants
w = 2
p = 2
s = 1.0e7
# settings
#set logscale xy
set grid xtics ytics lw w
set xtics font ',12'
set ytics font ',12'
set xlabel "MC Step (1e7)" font ',14'
set ylabel "q" font ',14'
# plot
plot [:] [0.4:]\
	'corr_edge.dat' using ($1/s):2 with points ps p lc 'red' title '',\
	x*0.0+5.0/9.0 with lines lw w lc 'blue' dt '-' title ''
pause -1 'continue'
